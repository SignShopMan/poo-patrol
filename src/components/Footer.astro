---
import { Image } from 'astro:assets';
import mascot from '../assets/brand/mascot.png';
import Icon from './Icon.astro';
import { site, services } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="band bg-band text-white">
  <div class="wrap grid grid-cols-1 md:grid-cols-[1.2fr_1fr_1fr_1fr] gap-8">
    <div>
      <div class="flex gap-4 items-center">
        <Image src={mascot} alt="" width={176} height={171} class="w-[88px] h-auto" />
        <div>
          <span class="display text-2xl block leading-none">Poo Patrol</span>
          <span class="subbrand block mt-1 opacity-85">Pet Waste Removal · Power Washing</span>
        </div>
      </div>
      <p class="text-sm leading-5 mt-4 mb-0 opacity-85 max-w-[34ch]">A clean yard. A healthy home. Peace of mind.</p>
    </div>
    <div>
      <h4 class="eyebrow m-0 mb-3 opacity-80">Call or text</h4>
      <a class="phone text-[22px] inline-flex items-center gap-2 text-inherit no-underline" href={site.phoneHref}><Icon name="phone" class="w-5 h-5" />{site.phone}</a>
      <p class="text-sm leading-5 mt-3 mb-0 opacity-85">Text anytime.<br />We answer fastest during the day.</p>
    </div>
    <div>
      <h4 class="eyebrow m-0 mb-3 opacity-80">Find us</h4>
      <ul class="list-none p-0 m-0 flex flex-col gap-2">
        <li>{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</li>
        <li><a class="text-inherit" href={site.facebook}>Facebook</a></li>
      </ul>
    </div>
    <div>
      <h4 class="eyebrow m-0 mb-3 opacity-80">Services</h4>
      <ul class="list-none p-0 m-0 flex flex-col gap-2">
        {services.map((s) => <li><a class="text-inherit" href={`${base}/#${s.id}`}>{s.title}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap">
    <div class="mt-8 pt-4 border-t border-white/20 text-sm leading-5 opacity-80 flex flex-wrap gap-x-6 gap-y-2">
      <span>© {year} {site.legalName}</span>
      <a class="text-inherit" href={`${base}/terms`}>Terms of service</a>
      <a class="text-inherit" href={`${base}/privacy`}>Privacy policy</a>
    </div>
  </div>
</footer>
