---
// Simple heavy line icons in currentColor. The nozzle is the brand's own mark and is an image, not an icon.
interface Props { name: string; class?: string }
const { name, class: cls = 'w-10 h-10' } = Astro.props;
const paths: Record<string, string> = {
  paw: '<path d="M12 21c-4 0-7-2.5-7-5.5S8 11 12 11s7 1.5 7 4.5S16 21 12 21Z"/><circle cx="6" cy="8" r="2"/><circle cx="10" cy="5" r="2"/><circle cx="14" cy="5" r="2"/><circle cx="18" cy="8" r="2"/>',
  gutter: '<path d="M3 10h18"/><path d="M3 10v4a3 3 0 0 0 3 3h12a3 3 0 0 0 3-3v-4"/><path d="M6 10V6l6-3 6 3v4"/>',
  leaf: '<path d="M4 20C4 10 10 4 20 4c0 10-6 16-16 16Z"/><path d="M4 20c4-4 8-8 12-12"/>',
  grass: '<path d="M3 20h18"/><path d="M5 20V9l4 3 3-6 3 6 4-3v11"/>',
  snow: '<path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  check: '<path d="M5 12l5 5L20 7"/>',
  mail: '<path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/>',
  form: '<path d="M4 4h16v16H4z"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  star: '<path d="M12 2l3 7 7 .6-5.3 4.7L18.5 22 12 18l-6.5 4 1.8-7.7L2 9.6 9 9z" fill="currentColor" stroke="none"/>',
};
const strokeWidth = name === 'check' ? 3 : 2;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name] ?? ''} />
