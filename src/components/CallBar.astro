---
import Icon from './Icon.astro';
import { site } from '../lib/site';
---
<div class="fixed inset-x-0 bottom-0 z-20 bg-band text-white shadow-lift px-4 pt-3 pb-[calc(12px+env(safe-area-inset-bottom,0px))] flex items-center justify-between gap-4 min-[1000px]:hidden">
  <span class="font-extrabold text-[15px]">Call or text us</span>
  <a class="phone text-[22px] inline-flex items-center gap-2 text-inherit no-underline" href={site.phoneHref}><Icon name="phone" class="w-5 h-5" />{site.phone}</a>
</div>
