---
import { Image } from 'astro:assets';
import mascot from '../assets/brand/mascot.png';
import Icon from './Icon.astro';
import { site } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['Services', '#services'],
  ['Pricing', '#pricing'],
  ['Service area', '#area'],
  ['Reviews', '#reviews'],
];
---
<header class="bg-band text-white sticky top-0 z-10">
  <div class="wrap flex items-center gap-4 min-h-[72px]">
    <a href={`${base}/`} class="flex items-center gap-3 no-underline text-inherit" aria-label="Poo Patrol home">
      <Image src={mascot} alt="" width={104} class="w-[52px] h-auto" loading="eager" />
      <span>
        <span class="display text-2xl block leading-none">Poo Patrol</span>
        <span class="subbrand block opacity-85 mt-0.5 whitespace-nowrap sm:hidden">Pet Waste Removal</span>
        <span class="subbrand hidden opacity-85 mt-0.5 whitespace-nowrap sm:block">Pet Waste Removal · Power Washing</span>
      </span>
    </a>
    <ul class="hidden min-[1000px]:flex gap-6 ml-auto list-none p-0 m-0">
      {links.map(([label, href]) => (
        <li><a href={`${base}/${href}`} class="text-inherit no-underline font-extrabold whitespace-nowrap hover:underline underline-offset-4">{label}</a></li>
      ))}
    </ul>
    <div class="hidden min-[1000px]:flex items-center gap-4">
      <a class="phone text-[22px] inline-flex items-center gap-2 text-inherit no-underline" href={site.phoneHref}><Icon name="phone" class="w-5 h-5" />{site.phone}</a>
      <a class="btn bg-patrol text-white border-patrol hover:bg-patrol-deep hover:border-patrol-deep py-2 hidden min-[1160px]:inline-flex" href={`${base}/#quote`}>Get a free quote</a>
    </div>
    <a class="ml-auto min-[1000px]:hidden inline-flex w-11 h-11 rounded-full bg-patrol text-white items-center justify-center" href={site.phoneHref} aria-label={`Call ${site.phone}`}><Icon name="phone" class="w-[22px] h-[22px]" /></a>
  </div>
</header>
