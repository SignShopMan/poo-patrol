---
interface Props { eyebrow: string; title: string; class?: string }
const { eyebrow, title, class: cls = 'mb-8' } = Astro.props;
---
<div class={`flex flex-col gap-3 max-w-[60ch] ${cls}`}>
  <p class="eyebrow text-patrol m-0">{eyebrow}</p>
  <h2 class="display text-[clamp(32px,4.5vw,40px)] m-0">{title}</h2>
  <slot />
</div>
